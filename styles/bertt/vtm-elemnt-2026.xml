<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" map-background="#FFFFFF"
	version="1" xmlns="http://opensciencemap.org/rendertheme"
	xsi:schemaLocation="http://opensciencemap.org/rendertheme https://raw.githubusercontent.com/mapsforge/vtm/master/resources/rendertheme.xsd">

	<!--
		vtm-elemnt-2026: a modern cycling map style for the Wahoo ELEMNT.
		Emphasis: small bike-able paths (cycleways, tracks, paths), hiking paths stay visible,
		motorways are muted and marked as 'no cycling'. Rename to vtm-elemnt.xml to use on the device.
		Colour legend: green = cycleway, orange = track, orange-red dashed = path, purple dashed = path/footway
		with bicycle=yes, brown dotted = hiking path, red dashes + sign = no cycling.
		Only the 64 colours of the Bolt 2 display are used (see wahoo_colors_64.md in the repo root).
		Icons live in symbols/ next to this file. A coloured dot is drawn below each icon as fallback.
	-->

	<stylemenu id="stylemenu" defaultvalue="BOLT_2" defaultlang="en">
		<layer id="BOLT_2"><name lang="en" value="Bolt2"/><cat id="bolt2"/><cat id="trails-osm"/></layer>
		<layer id="BOLT_2-DARK"><name lang="en" value="Bolt2"/><cat id="bolt2-dark"/><cat id="trails-osm"/></layer>
		<layer id="BOLT_2-TF"><name lang="en" value="TF"/><cat id="bolt2"/><cat id="trails-tf"/></layer>
		<layer id="BOLT_2-DARK-TF"><name lang="en" value="TF"/><cat id="bolt2-dark"/><cat id="trails-tf"/></layer>
		<layer id="ROAM_2"><name lang="en" value="Roam2"/><cat id="roam2"/><cat id="trails-osm"/></layer>
		<layer id="ROAM_2-DARK"><name lang="en" value="Roam2"/><cat id="roam2-dark"/><cat id="trails-osm"/></layer>
		<layer id="ROAM_2-TF"><name lang="en" value="TF"/><cat id="roam2"/><cat id="trails-tf"/></layer>
		<layer id="ROAM_2-DARK-TF"><name lang="en" value="TF"/><cat id="roam2-dark"/><cat id="trails-tf"/></layer>
	</stylemenu>

	<!-- region outline layers -->
	<m e="way" k="highway" zoom-min="8">
		<outline-layer cat="bolt2" id="bolt2-halo" stroke="#FFFFFF" width="0.3"/>
		<outline-layer cat="bolt2" id="bolt2-casing" stroke="#55AA55" width="0.35"/>
		<outline-layer cat="bolt2-dark" id="bolt2-dark-halo" stroke="#000000" width="0.3"/>
		<outline-layer cat="bolt2-dark" id="bolt2-dark-casing" stroke="#000000" width="0.35"/>
		<outline-layer cat="roam2" id="roam2-halo" stroke="#FFFFFF" width="0.3"/>
		<outline-layer cat="roam2" id="roam2-casing" stroke="#55AA55" width="0.35"/>
		<outline-layer cat="roam2-dark" id="roam2-dark-halo" stroke="#000000" width="0.3"/>
		<outline-layer cat="roam2-dark" id="roam2-dark-casing" stroke="#000000" width="0.35"/>
	</m>
	
	<!-- region icon styles: to add a POI, add a style here and a rule in the POI region -->
	<style-symbol id="poi-water" src="symbols/poi_water.png" symbol-width="22"/>
	<style-symbol id="poi-toilets" src="symbols/poi_toilets.png" symbol-width="22"/>
	<style-symbol id="poi-shelter" src="symbols/poi_shelter.png" symbol-width="22"/>
	<style-symbol id="poi-picnic" src="symbols/poi_picnic.png" symbol-width="22"/>
	<style-symbol id="poi-viewpoint" src="symbols/poi_viewpoint.png" symbol-width="22"/>
	<style-symbol id="poi-bikeshop" src="symbols/poi_bikeshop.png" symbol-width="22"/>
	<style-symbol id="poi-bikerental" src="symbols/poi_bikerental.png" symbol-width="22"/>
	<style-symbol id="poi-ferry" src="symbols/poi_ferry.png" symbol-width="22"/>
	
	<!-- region land/sea/water -->
	<m e="way" k="natural" v="sea">
		<area cat="bolt2" fill="#AAFFFF"/>
		<area cat="bolt2-dark" fill="#000055"/>
		<area cat="roam2" fill="#AAFFFF"/>
		<area cat="roam2-dark" fill="#000055"/>
	</m>
	<m e="way" k="natural" v="nosea">
		<area cat="bolt2" fill="#FFFFFF"/>
		<area cat="bolt2-dark" fill="#000000"/>
		<area cat="roam2" fill="#FFFFFF"/>
		<area cat="roam2-dark" fill="#000000"/>
	</m>
	<m e="way" k="leisure" v="nature_reserve">
		<area cat="bolt2" fill="#FFFFFF"/>
		<area cat="bolt2-dark" fill="#000000"/>
		<area cat="roam2" fill="#FFFFFF"/>
		<area cat="roam2-dark" fill="#000000"/>
	</m>
	<m e="way" k="landuse" v="grass|meadow|village_green|recreation_ground|orchard|brownfield">
		<area cat="bolt2" fill="#FFFFFF"/>
		<area cat="bolt2-dark" fill="#000000"/>
		<area cat="roam2" fill="#FFFFFF"/>
		<area cat="roam2-dark" fill="#000000"/>
	</m>
	<m e="way" k="natural" v="grassland|heath">
		<area cat="bolt2" fill="#FFFFAA"/>
		<area cat="bolt2-dark" fill="#555500"/>
		<area cat="roam2" fill="#FFFFAA"/>
		<area cat="roam2-dark" fill="#555500"/>
	</m>
	<m e="way" k="leisure" v="park|garden|common|dog_park|golf_course|playground">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="leisure" v="pitch|sports_centre">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="landuse" v="cemetery">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="amenity" v="grave_yard">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="natural" v="wood|scrub">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="landuse" v="forest">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="natural" v="scrub">
		<area cat="bolt2" fill="#AAFFAA"/>
		<area cat="bolt2-dark" fill="#005500"/>
		<area cat="roam2" fill="#AAFFAA"/>
		<area cat="roam2-dark" fill="#005500"/>
	</m>
	<m e="way" k="natural" v="wetland">
		<area cat="bolt2" fill="#AAFFFF"/>
		<area cat="bolt2-dark" fill="#005555"/>
		<area cat="roam2" fill="#AAFFFF"/>
		<area cat="roam2-dark" fill="#005555"/>
	</m>
	<m e="way" k="natural" v="beach|sand|dune">
		<area cat="bolt2" fill="#FFFFAA"/>
		<area cat="bolt2-dark" fill="#555500"/>
		<area cat="roam2" fill="#FFFFAA"/>
		<area cat="roam2-dark" fill="#555500"/>
	</m>
	<m e="way" k="highway" v="pedestrian" closed="yes">
		<area cat="bolt2" fill="#FFFFFF"/>
		<area cat="bolt2-dark" fill="#000000"/>
		<area cat="roam2" fill="#FFFFFF"/>
		<area cat="roam2-dark" fill="#000000"/>
	</m>
	<m e="way" k="area:highway" v="pedestrian">
		<area cat="bolt2" fill="#FFFFFF"/>
		<area cat="bolt2-dark" fill="#000000"/>
		<area cat="roam2" fill="#FFFFFF"/>
		<area cat="roam2-dark" fill="#000000"/>
	</m>
	<m e="way" k="natural" v="water">
		<area cat="bolt2" fill="#AAFFFF"/>
		<area cat="bolt2-dark" fill="#000055"/>
		<area cat="roam2" fill="#AAFFFF"/>
		<area cat="roam2-dark" fill="#000055"/>
	</m>
	<m e="way" k="landuse" v="basin|reservoir">
		<area cat="bolt2" fill="#AAFFFF"/>
		<area cat="bolt2-dark" fill="#000055"/>
		<area cat="roam2" fill="#AAFFFF"/>
		<area cat="roam2-dark" fill="#000055"/>
	</m>
	<m e="way" k="leisure" v="swimming_pool|swimming_area|water_park">
		<area cat="bolt2" fill="#AAFFFF"/>
		<area cat="bolt2-dark" fill="#000055"/>
		<area cat="roam2" fill="#AAFFFF"/>
		<area cat="roam2-dark" fill="#000055"/>
	</m>
	<m e="way" k="waterway" v="river|riverbank|canal|dock" closed="yes">
		<area cat="bolt2" fill="#AAFFFF"/>
		<area cat="bolt2-dark" fill="#000055"/>
		<area cat="roam2" fill="#AAFFFF"/>
		<area cat="roam2-dark" fill="#000055"/>
	</m>
	<m e="way" k="waterway" v="river|canal" zoom-min="8">
		<line cat="bolt2" stroke="#00AAFF" width="1.6"/>
		<line cat="bolt2-dark" stroke="#0055FF" width="1.6"/>
		<line cat="roam2" stroke="#00AAFF" width="1.6"/>
		<line cat="roam2-dark" stroke="#0055FF" width="1.6"/>
	</m>
	<m e="way" k="waterway" v="stream" zoom-min="13">
		<line cat="bolt2" stroke="#00AAFF" width="0.5"/>
		<line cat="bolt2-dark" stroke="#0055FF" width="0.5"/>
		<line cat="roam2" stroke="#00AAFF" width="0.5"/>
		<line cat="roam2-dark" stroke="#0055FF" width="0.5"/>
	</m>
	<m e="way" k="waterway" v="drain" zoom-min="15">
		<line cat="bolt2" stroke="#00AAFF" width="0.35"/>
		<line cat="bolt2-dark" stroke="#0055FF" width="0.35"/>
		<line cat="roam2" stroke="#00AAFF" width="0.35"/>
		<line cat="roam2-dark" stroke="#0055FF" width="0.35"/>
	</m>
	<m e="way" k="route" v="ferry" zoom-min="10">
		<line cat="bolt2" stroke="#0055FF" width="0.9" dasharray="6,4" cap="butt"/>
		<line cat="bolt2-dark" stroke="#00AAFF" width="0.9" dasharray="6,4" cap="butt"/>
		<line cat="roam2" stroke="#0055FF" width="0.9" dasharray="6,4" cap="butt"/>
		<line cat="roam2-dark" stroke="#00AAFF" width="0.9" dasharray="6,4" cap="butt"/>
	</m>
	
	<!-- region railways -->
	<m e="way" k="railway" v="rail|light_rail|narrow_gauge|subway" zoom-min="10">
		<m k="tunnel" v="~|no|false">
			<line cat="bolt2" stroke="#555555" width="0.8"/>
			<line cat="bolt2-dark" stroke="#AAAAAA" width="0.8"/>
			<line cat="roam2" stroke="#555555" width="0.8"/>
			<line cat="roam2-dark" stroke="#AAAAAA" width="0.8"/>
			<line cat="bolt2" stroke="#FFFFFF" width="0.4" dasharray="5,5" cap="butt"/>
			<line cat="bolt2-dark" stroke="#000000" width="0.4" dasharray="5,5" cap="butt"/>
			<line cat="roam2" stroke="#FFFFFF" width="0.4" dasharray="5,5" cap="butt"/>
			<line cat="roam2-dark" stroke="#000000" width="0.4" dasharray="5,5" cap="butt"/>
		</m>
	</m>
	<m e="way" k="railway" v="tram" zoom-min="14">
		<m k="tunnel" v="~|no|false">
			<line cat="bolt2" stroke="#555555" width="0.4"/>
			<line cat="bolt2-dark" stroke="#AAAAAA" width="0.4"/>
			<line cat="roam2" stroke="#555555" width="0.4"/>
			<line cat="roam2-dark" stroke="#AAAAAA" width="0.4"/>
		</m>
	</m>
	
	<!-- region roads: muted, bottom of the stack -->
	<m e="way" k="tunnel" v="~|no|false">
		<m e="way" k="area" v="~|no|false">
			<m e="way" k="highway" v="motorway|motorway_link" zoom-min="8">
				<line cat="bolt2" stroke="#AAAAAA" width="2.2" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#555555" width="2.2" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#AAAAAA" width="2.2" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#555555" width="2.2" outline="roam2-dark-casing"/>
			</m>
			<m e="way" k="highway" v="trunk|trunk_link" zoom-min="9">
				<line cat="bolt2" stroke="#FFAA00" width="2.0" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#AA5500" width="2.0" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#FFAA00" width="2.0" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#AA5500" width="2.0" outline="roam2-dark-casing"/>
			</m>
			<m e="way" k="highway" v="primary|primary_link" zoom-min="9">
				<line cat="bolt2" stroke="#FFAA55" width="2.0" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#AA5500" width="2.0" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#FFAA55" width="2.0" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#AA5500" width="2.0" outline="roam2-dark-casing"/>
			</m>
			<m e="way" k="highway" v="secondary|secondary_link" zoom-min="10">
				<line cat="bolt2" stroke="#FFFF55" width="1.9" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#555500" width="1.9" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#FFFF55" width="1.9" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#555500" width="1.9" outline="roam2-dark-casing"/>
			</m>
			<m e="way" k="highway" v="tertiary|tertiary_link" zoom-min="11">
				<line cat="bolt2" stroke="#FFD84D" width="1.8" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#555555" width="1.8" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#FFD84D" width="1.8" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#555555" width="1.8" outline="roam2-dark-casing"/>
			</m>
			<m e="way" k="highway" v="residential|living_street|road|unclassified" zoom-min="12">
				<line cat="bolt2" stroke="#00AA00" width="1.5" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#55AA55" width="1.5" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#00AA00" width="1.5" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#55AA55" width="1.5" outline="roam2-dark-casing"/>
			</m>
			<m e="way" k="highway" v="service" zoom-min="14">
				<line cat="bolt2" stroke="#00AA00" width="0.9" outline="bolt2-casing"/>
				<line cat="bolt2-dark" stroke="#55AA55" width="0.9" outline="bolt2-dark-casing"/>
				<line cat="roam2" stroke="#00AA00" width="0.9" outline="roam2-casing"/>
				<line cat="roam2-dark" stroke="#55AA55" width="0.9" outline="roam2-dark-casing"/>
			</m>
		</m>
	</m>
	
	<!-- region cycle lanes/tracks drawn on top of roads -->
	<m e="way" k="tunnel" v="~|no|false">
		<m e="way" k="highway" v="residential|living_street|road|unclassified|tertiary|tertiary_link|secondary|secondary_link|primary|primary_link" zoom-min="13">
			<m k="cycleway_track" v="cw_track_both|cw_track_right|cw_track_left|cw_track_oneway">
				<line cat="bolt2" stroke="#00AA00" width="0.5"/>
				<line cat="bolt2-dark" stroke="#55FF55" width="0.5"/>
				<line cat="roam2" stroke="#00AA00" width="0.5"/>
				<line cat="roam2-dark" stroke="#55FF55" width="0.5"/>
			</m>
			<m k="cycleway_lane" v="cw_lane_both|cw_lane_right|cw_lane_left|cw_lane_oneway">
				<line cat="bolt2" stroke="#00AA00" width="0.5" dasharray="6,3" cap="butt"/>
				<line cat="bolt2-dark" stroke="#AAFFAA" width="0.5" dasharray="6,3" cap="butt"/>
				<line cat="roam2" stroke="#00AA00" width="0.5" dasharray="6,3" cap="butt"/>
				<line cat="roam2-dark" stroke="#AAFFAA" width="0.5" dasharray="6,3" cap="butt"/>
			</m>
		</m>
	</m>
	
	<!-- region paths, tracks, cycleways: top of the stack -->
	<m e="way" k="tunnel" v="~|no|false">
		<m e="way" k="area" v="~|no|false">
			<m e="way" k="highway" v="bridleway" zoom-min="13">
				<line cat="bolt2" stroke="#555500" width="0.7" dasharray="2,4" cap="butt"/>
				<line cat="bolt2-dark" stroke="#AA5500" width="0.7" dasharray="2,4" cap="butt"/>
				<line cat="roam2" stroke="#555500" width="0.7" dasharray="2,4" cap="butt"/>
				<line cat="roam2-dark" stroke="#AA5500" width="0.7" dasharray="2,4" cap="butt"/>
			</m>
			<m e="way" k="highway" v="steps" zoom-min="15">
				<line cat="bolt2" stroke="#555555" width="0.7" dasharray="2,2" cap="butt"/>
				<line cat="bolt2-dark" stroke="#AAAAAA" width="0.7" dasharray="2,2" cap="butt"/>
				<line cat="roam2" stroke="#555555" width="0.7" dasharray="2,2" cap="butt"/>
				<line cat="roam2-dark" stroke="#AAAAAA" width="0.7" dasharray="2,2" cap="butt"/>
			</m>
			<m e="way" k="highway" v="footway|pedestrian" zoom-min="12" select="first">
				<m k="bicycle" v="bic_yes|bic_designated|bic_permissive">
					<line cat="bolt2" stroke="#AA00FF" width="0.9" dasharray="6,3" cap="butt" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#AA55FF" width="0.9" dasharray="6,3" cap="butt" outline="bolt2-dark-halo"/>
					<line cat="roam2" stroke="#AA00FF" width="0.9" dasharray="6,3" cap="butt" outline="roam2-halo"/>
					<line cat="roam2-dark" stroke="#AA55FF" width="0.9" dasharray="6,3" cap="butt" outline="roam2-dark-halo"/>
				</m>
				<m k="highway" v="footway|pedestrian">
					<line cat="bolt2" stroke="#550000" width="0.9" dasharray="2,3" cap="butt" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#FFAA55" width="0.9" dasharray="2,3" cap="butt" outline="bolt2-dark-halo"/>
					<line cat="roam2" stroke="#550000" width="0.9" dasharray="2,3" cap="butt" outline="roam2-halo"/>
					<line cat="roam2-dark" stroke="#FFAA55" width="0.9" dasharray="2,3" cap="butt" outline="roam2-dark-halo"/>
				</m>
			</m>
			<m e="way" k="highway" v="path" zoom-min="11" select="first">
				<m k="bicycle" v="bic_no|bic_private">
					<line cat="bolt2" stroke="#550000" width="0.9" dasharray="2,3" cap="butt" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#FFAA55" width="0.9" dasharray="2,3" cap="butt" outline="bolt2-dark-halo"/>
					<line cat="roam2" stroke="#550000" width="0.9" dasharray="2,3" cap="butt" outline="roam2-halo"/>
					<line cat="roam2-dark" stroke="#FFAA55" width="0.9" dasharray="2,3" cap="butt" outline="roam2-dark-halo"/>
				</m>
				<m k="bicycle" v="bic_yes|bic_designated|bic_permissive">
					<line cat="bolt2" stroke="#AA00FF" width="1.0" dasharray="6,3" cap="butt" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#AA55FF" width="1.0" dasharray="6,3" cap="butt" outline="bolt2-dark-halo"/>
					<line cat="roam2" stroke="#AA00FF" width="1.0" dasharray="6,3" cap="butt" outline="roam2-halo"/>
					<line cat="roam2-dark" stroke="#AA55FF" width="1.0" dasharray="6,3" cap="butt" outline="roam2-dark-halo"/>
				</m>
				<m k="foot" v="ft_designated">
					<m k="bicycle" v="~">
						<line cat="bolt2" stroke="#550000" width="0.9" dasharray="2,3" cap="butt" outline="bolt2-halo"/>
						<line cat="bolt2-dark" stroke="#FFAA55" width="0.9" dasharray="2,3" cap="butt" outline="bolt2-dark-halo"/>
						<line cat="roam2" stroke="#550000" width="0.9" dasharray="2,3" cap="butt" outline="roam2-halo"/>
						<line cat="roam2-dark" stroke="#FFAA55" width="0.9" dasharray="2,3" cap="butt" outline="roam2-dark-halo"/>
					</m>
				</m>
				<m k="highway" v="path">
					<line cat="bolt2" stroke="#FF5500" width="1.0" dasharray="7,3" cap="butt" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#FF5500" width="1.0" dasharray="7,3" cap="butt" outline="bolt2-dark-halo"/>
					<line cat="roam2" stroke="#FF5500" width="1.0" dasharray="7,3" cap="butt" outline="roam2-halo"/>
					<line cat="roam2-dark" stroke="#FF5500" width="1.0" dasharray="7,3" cap="butt" outline="roam2-dark-halo"/>
				</m>
			</m>
			<m e="way" k="highway" v="track|byway" zoom-min="11" select="first">
				<m k="tracktype" v="grade1|grade2">
					<line cat="bolt2" stroke="#AA5500" width="1.3" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#FFAA00" width="1.3" outline="bolt2-dark-halo"/>
					<line cat="roam2" stroke="#AA5500" width="1.3" outline="roam2-halo"/>
					<line cat="roam2-dark" stroke="#FFAA00" width="1.3" outline="roam2-dark-halo"/>
				</m>
				<m k="tracktype" v="grade3">
					<line cat="bolt2" stroke="#AA5500" width="1.2" dasharray="14,2" cap="butt" outline="bolt2-halo"/>
					<line cat="bolt2-dark" stroke="#FFAA00" width="1.2" dasharray="14,2" cap="butt" outline="bolt2-dark-halo"/>
